        },
        {
          "module": "CurveControl.Analysis.CurveEstimateAssembly",
          "file": "CurveControl/Analysis/CurveEstimateAssembly.lean",
          "declarations": [
            "CurveControl.Analysis.ScalarCurveHypotheses.regularized_comparison"
          ]
        }
      ],
      "dependencies": [
        "moving_integrals"
      ],
      "source_references": [
        "mathlib",
        "mt2015"
      ],
      "contribution": {
        "category": "adapted",
        "detail": "将蓝图中的绝对连续及几乎处处导数比较，适配为内点导数与闭区间连续性路线。"
      },
      "scope_caveats": [
