  "nodes": [
    {
      "id": "flow_input",
      "title": "实际 Ricci 流与浸入闭曲线流",
      "kind": "definition",
      "math_statement": "g_t=-2\\operatorname{Ric}_{g(t)},\\qquad c_t=H,\\qquad c(t,x+1)=c(t,x),\\quad c_x\\ne0.",
      "explanation": "输入为光滑度量族和联合光滑的浸入周期曲线族。时间方程采用给定时间集合内的导数。",
      "lean": [
        {
          "module": "CurveControl.Geometry.Flow",
          "file": "CurveControl/Geometry/Flow.lean",
          "declarations": [
            "CurveControl.Geometry.IsCurveShorteningFlowOn"
          ]
        }
      ],
      "dependencies": [],
      "source_references": [
        "upstream",
        "mt2015"
      ],
      "contribution": {
        "category": "adapted",
        "detail": "复用上游 Ricci 流谓词，新增实际周期曲线流接口。"
      },
      "scope_caveats": [
        "以已有光滑流为输入；存在与延拓由外围理论提供。",
        "高阶演化恒等式在时间内点成立。"
      ]
    },
    {
      "id": "curve_geometry",
      "title": "内蕴曲线几何与移动测度",
      "kind": "definition",
      "math_statement": "X=c_x,\\quad v=|X|_g,\\quad S=v^{-1}X,\\quad H=D_sS,\\quad q=|H|_g^2,\\quad ds=v\\,dx.\\qquad L=\\int_0^1v\\,dx,\\quad\\Theta=\\int_0^1\\sqrt q\\,v\\,dx.",
      "explanation": "协变导数在固定有效图册中读取沿曲线移动的切向量场。长度和张量缩并使用演化度量。",
      "lean": [
        {
          "module": "CurveControl.Geometry.Basic",
          "file": "CurveControl/Geometry/Basic.lean",
          "declarations": [
            "CurveControl.Geometry.curveSpeed",
            "CurveControl.Geometry.unitTangent",
            "CurveControl.Geometry.covDerivAlong",
            "CurveControl.Geometry.curvatureVector",
            "CurveControl.Geometry.curvatureSq",
            "CurveControl.Geometry.curveLength",
            "CurveControl.Geometry.totalCurvature",
            "CurveControl.Geometry.regularizedTotalCurvature",
            "CurveControl.Geometry.curvatureEnergy"
          ]
        }
      ],
      "dependencies": [
        "flow_input"
      ],
      "source_references": [
        "upstream",
        "mt2015"
      ],
      "contribution": {
        "category": "new formalization",
        "detail": "定义本项目使用的几何量和积分密度。"
      },
      "scope_caveats": [
        "闭曲线用周期为一的实参数化表示，允许自交。"
      ]
    },
    {
      "id": "speed_evolution",
      "title": "速度与单位切向量的演化",
      "kind": "theorem",
      "math_statement": "v_t=-(q+\\operatorname{Ric}(S,S))v,\\qquad D_tS=D_sH+(q+\\operatorname{Ric}(S,S))S.",
      "explanation": "流方程给出混合协变导数恒等式，进而推出速度演化律。",
      "lean": [
        {
          "module": "CurveControl.Geometry.SpeedEvolution",
          "file": "CurveControl/Geometry/SpeedEvolution.lean",
          "declarations": [
            "CurveControl.Geometry.IsCurveShorteningFlowOn.hasDerivAt_curveSpeed_time",
            "CurveControl.Geometry.IsCurveShorteningFlowOn.hasCovDerivAt_unitTangent_time"
          ]
        }
      ],
      "dependencies": [
        "flow_input",
        "curve_geometry"
      ],
      "source_references": [
        "mt2015",
        "target_blueprint"
      ],
      "contribution": {
        "category": "new formalization",
        "detail": "由混合导数和度量变分推导速度及切向量演化。"
      },
      "scope_caveats": [
        "经典时间导数的结论在时间内点给出。"
      ]
    },
    {
      "id": "connection_variation",
      "title": "Levi-Civita 联络的时间变分",
      "kind": "theorem",
      "math_statement": "\\langle (\\partial_t\\nabla)(U,V),W\\rangle=- (\\nabla_U\\operatorname{Ric})(V,W)-(\\nabla_V\\operatorname{Ric})(U,W)+(\\nabla_W\\operatorname{Ric})(U,V).",
      "explanation": "在固定空间图册坐标点对 Christoffel 符号作时间微分，再用 g(t) 降指标。",
      "lean": [
        {
          "module": "CurveControl.Geometry.RicciConnectionVariation",
          "file": "CurveControl/Geometry/RicciConnectionVariation.lean",
          "declarations": [
            "CurveControl.Geometry.RicciConnectionVariation.deriv_chartChristoffelBilin_lower_intrinsic"
          ]
        }
      ],
      "dependencies": [
        "flow_input"
      ],
      "source_references": [
        "mt2015",
        "upstream"
      ],
      "contribution": {
        "category": "adapted",
        "detail": "将时空计算适配为随时间变化的空间联络计算。"
      },
      "scope_caveats": [
        "降指标指用 g(t) 作用于联络的时间导数；度量变分项另行处理。"
      ]
    },
    {
      "id": "curvature_evolution",
      "title": "修正后的曲率平方演化",
      "kind": "theorem",
      "math_statement": "P=D_sH+qS,\\quad q_t=q_{ss}-2|P|^2+2q^2+4q\\operatorname{Ric}(S,S)-2\\operatorname{Ric}(H,H)+2\\mathrm{rm}(H,S,H,S)-4(\\nabla_S\\operatorname{Ric})(S,H)+2(\\nabla_H\\operatorname{Ric})(S,S).",
      "explanation": "由给定流推导曲率向量演化、所需协变正则性、联络降指标公式及曲率符号转换。",
      "lean": [
        {
          "module": "CurveControl.Geometry.CurvatureEvolution",
          "file": "CurveControl/Geometry/CurvatureEvolution.lean",
          "declarations": [
            "CurveControl.Geometry.IsCurveShorteningFlowOn.hasDerivAt_curvatureSq_time",
            "CurveControl.Geometry.chartCurvature_pairing_canonical"
          ]
        }
      ],
      "dependencies": [
        "curve_geometry",
        "speed_evolution",
        "connection_variation"
      ],
      "source_references": [
        "mt2015",
        "target_blueprint"
      ],
      "contribution": {
        "category": "adapted",
        "detail": "通过等价的纯空间联络计算，形式化修正后的演化公式。"
      },
      "scope_caveats": [
        "P 是空间法向投影；时空法向投影还包含额外分量。",
        "曲率平方的偏微分方程由流输入推导。"
      ]
    },
    {
      "id": "spatial_kato",
      "title": "空间 Kato 不等式",
      "kind": "theorem",
      "math_statement": "(D_sq)^2\\le4q|P|^2,\\qquad |D_sH|^2=|P|^2+q^2.",
      "explanation": "度量下的 Cauchy–Schwarz 不等式与协变可微性，给出曲率零点处的梯度控制。",
      "lean": [
        {
          "module": "CurveControl.Geometry.CurvatureGradient",
          "file": "CurveControl/Geometry/CurvatureGradient.lean",
          "declarations": [
            "CurveControl.Geometry.curvatureGradient_norm_decomposition"
          ]
        },
        {
          "module": "CurveControl.Geometry.CurveEstimates",
          "file": "CurveControl/Geometry/CurveEstimates.lean",
          "declarations": [
            "CurveControl.Geometry.IsCurveShorteningFlowOn.curvatureSq_kato_closed"
          ]
        }
      ],
      "dependencies": [
        "curve_geometry",
        "flow_input"
      ],
      "source_references": [
        "mt2015"
      ],
      "contribution": {
        "category": "new formalization",
        "detail": "证明度量梯度恒等式，并由流条件得到所需正则性。"
      },
      "scope_caveats": [
        "论证使用 q 及其导数，涵盖 q=0 的情形。"
      ]
    },
    {
      "id": "ambient_error",
      "title": "一致的环境误差系数",
      "kind": "theorem",
      "math_statement": "|\\mathrm{Err}|\\le(6B+2K)q+6D\\sqrt q\\le A(q+\\sqrt q),\\qquad A=\\max(6B+2K,6D).",
      "explanation": "B、K、D 分别控制 Ricci 张量、Riemann 曲率和 Ricci 协变导数的评估，界采用度量范数。",
      "lean": [
        {
          "module": "CurveControl.Geometry.AmbientBounds",
          "file": "CurveControl/Geometry/AmbientBounds.lean",
          "declarations": [
            "CurveControl.Geometry.AmbientBounds.TensorBoundsAt",
            "CurveControl.Geometry.AmbientBounds.UniformTensorBoundsOn",
            "CurveControl.Geometry.AmbientBounds.curve_ambient_error"
          ]
        },
        {
          "module": "CurveControl.Geometry.CurveEstimates",
          "file": "CurveControl/Geometry/CurveEstimates.lean",
          "declarations": [
            "CurveControl.Geometry.curve_ambient_error_le_max",
            "CurveControl.Geometry.IsCurveShorteningFlowOn.curvatureSq_time_le"
          ]
        }
      ],
      "dependencies": [
        "curvature_evolution"
      ],
      "source_references": [
        "mt2015",
        "perelman2003"
      ],
      "contribution": {
        "category": "new formalization",
        "detail": "从每个修正项中提取仅依赖环境几何的显式系数。"
      },
      "scope_caveats": [
        "这一层以张量界为输入；后续由紧致性给出这些界。"
      ]
    },
    {
      "id": "regularized_pde",
      "title": "正参数正则化与标量偏微分不等式",
      "kind": "theorem",
      "math_statement": "h_\\varepsilon=\\sqrt{q+\\varepsilon^2},\\quad\\varepsilon>0,\\qquad \\partial_th_\\varepsilon\\le D_s^2h_\\varepsilon+q^{3/2}+\\frac A2(h_\\varepsilon+1).",
      "explanation": "链式法则和 Kato 消去保留曲率的一次误差项，正则化处理 q=0 的情形。",
      "lean": [
        {
          "module": "CurveControl.Analysis.RegularizedPDE",
          "file": "CurveControl/Analysis/RegularizedPDE.lean",
          "declarations": [
            "CurveControl.Analysis.deriv_regularizedNorm_le"
          ]
        }
      ],
      "dependencies": [
        "spatial_kato",
        "ambient_error"
      ],
      "source_references": [
        "mt2015"
      ],
      "contribution": {
        "category": "new formalization",
        "detail": "证明正则化分析不等式，并将其用于几何偏微分方程。"
      },
      "scope_caveats": [
        "局部分析引理以标量偏微分方程和可微性为假设；几何定理证明这些输入。"
      ]
    },
    {
      "id": "moving_integrals",
      "title": "移动弧长积分与周期项消去",
      "kind": "theorem",
      "math_statement": "\\Theta_\\varepsilon=\\int_0^1h_\\varepsilon v\\,dx,\\qquad L\\prime\\le BL-\\int q\\,ds,\\qquad \\Theta_\\varepsilon\\prime\\le(A/2+B)\\Theta_\\varepsilon+(A/2)L.",
      "explanation": "联合光滑性保证含参数积分可微。周期性消去弧长扩散项的积分通量；移动密度吸收曲率三次项。",
      "lean": [
        {
          "module": "CurveControl.Analysis.IntegralEstimates",
          "file": "CurveControl/Analysis/IntegralEstimates.lean",
          "declarations": [
            "CurveControl.Analysis.deriv_length_le",
            "CurveControl.Analysis.deriv_regularizedTotal_le"
          ]
        },
        {
          "module": "CurveControl.Analysis.CurveEstimateAssembly",
          "file": "CurveControl/Analysis/CurveEstimateAssembly.lean",
          "declarations": [
            "CurveControl.Analysis.ScalarCurveHypotheses.regularized_deriv_le"
          ]
        }
      ],
      "dependencies": [
        "regularized_pde",
        "speed_evolution"
      ],
      "source_references": [
        "mt2015",
        "mathlib"
      ],
      "contribution": {
        "category": "new formalization",
        "detail": "将含参数积分和微积分基本定理用于密度 v，并在整合证明中建立所需正则性。"
      },
      "scope_caveats": [
        "固定 epsilon 的控制函数可以依赖 epsilon；比较系数对 epsilon 一致。",
        "时间微分用于 L 和正则化总曲率；Theta 的几乎处处导数接口还需另行证明。"
      ]
    },
    {
      "id": "interior_comparison",
      "title": "由内点导数与闭区间连续性得到比较",
      "kind": "theorem",
      "math_statement": "L(t)\\le L(a)e^{B(t-a)},\\qquad \\Theta_\\varepsilon(t)+L(t)\\le(\\Theta_\\varepsilon(a)+L(a))e^{C(t-a)},\\quad C=A/2+B.",
      "explanation": "内点导数比较与闭区间连续性将初始界传递至两个时间端点。",
      "lean": [
        {
          "module": "CurveControl.Analysis.InteriorComparison",
          "file": "CurveControl/Analysis/InteriorComparison.lean",
          "declarations": [
