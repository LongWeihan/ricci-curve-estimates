      ]
    },
    {
      "id": "actual_curve_estimate",
      "title": "实际几何中的长度与总曲率界",
      "kind": "theorem",
      "math_statement": "L(t)\\le L(a)e^{B(t-a)},\\qquad\\Theta(t)+L(t)\\le(\\Theta(a)+L(a))e^{(\\max(6B+2K,6D)/2+B)(t-a)}.",
      "explanation": "流方程和环境界给出分析比较所需的全部标量假设。",
      "lean": [
        {
          "module": "CurveControl.Geometry.CurveEstimates",
          "file": "CurveControl/Geometry/CurveEstimates.lean",
          "declarations": [
