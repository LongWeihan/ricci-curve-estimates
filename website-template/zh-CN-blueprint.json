      ]
    },
    {
      "id": "epsilon_limit",
      "title": "比较之后去除正则化",
      "kind": "theorem",
      "math_statement": "0\\le\\Theta_\\varepsilon(t)-\\Theta(t)\\le\\varepsilon L(t),\\qquad\\Theta_\\varepsilon(t)\\longrightarrow\\Theta(t)\\quad(\\varepsilon\\downarrow0).",
      "explanation": "在已经证明的比较不等式两端取极限。",
      "lean": [
        {
          "module": "CurveControl.Analysis.RegularizedIntegral",
          "file": "CurveControl/Analysis/RegularizedIntegral.lean",
