{
  "schema_version": 1,
  "title": "Ricci 流下的曲线控制：数学蓝图",
  "language": "zh-CN",
  "scope": "对 Ricci 流下已有的光滑浸入闭曲线族，形式化证明长度与总曲率的一致估计，并覆盖任意静态一维因子度量。",
  "dependency_semantics": "图中的边表示组织数学阐述所选取的前置结果。",
  "notation": {
    "time": "a <= t <= b 位于给定的 Ricci 流时间集合内；高阶演化公式在时间内点证明。",
    "space": "x 是周期为一的实参数；D_s = v^{-1}D_x。",
    "metric": "所有张量范数、内积配对和曲线量均使用实际的 g(t) 或其真实产品度量。",
    "curvature_sign": "rm 使用上游库的内蕴四阶曲率形式；已显式证明它与符号相反的图册曲率算子之间的转换。",
    "constants": "B 控制 Ricci 张量，K 控制 Riemann 曲率，D 控制 Ricci 张量的协变导数；A=max(6B+2K,6D)，C=A/2+B。",
    "regularization": "epsilon > 0；先对 Theta_epsilon 作比较，再令 epsilon 趋于零。"
  },
  "references": [
    {
      "id": "mt2015",
      "title": "《Ricci Flow and the Poincaré Conjecture》第 19.2 节更正，引理 0.1–0.4",
